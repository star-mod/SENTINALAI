DATABASE_URL=sqlite:///./sentinelai.db
MEDIA_DIR=./media
ENABLE_PIPELINE=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo-only credentials for local testing; replace every value before deployment.
APP_ENV=development
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
APP_DASHBOARD_TOKEN=demo-admin-token
INTERNAL_API_TOKEN=local-dev-internal-token

# Keep disabled until an authenticated n8n incident workflow is configured.
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=5
