{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelai.local/contracts/incident-event-v1.schema.json",
  "title": "SentinelAI Incident Event",
  "description": "Version 1 incident event shared by CV producers, FastAPI, n8n, and the dashboard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "event_id", "camera_id", "camera_name", "location", "type", "confidence",
    "severity", "timestamp", "status", "snapshot_url", "clip_url",
    "notes", "verification"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "camera_id": { "type": "string", "minLength": 1, "maxLength": 32 },
    "camera_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng", "label"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "label": { "type": "string", "maxLength": 200 }
      }
    },
    "type": { "type": "string", "enum": ["physical_altercation", "fall_collapse", "abnormal_crowd_movement"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Computer-vision detection confidence." },
    "severity": { "type": "string", "enum": ["low", "medium", "high"], "description": "Incident impact assessment, independent of detector confidence." },
    "severity_verified": { "type": "boolean", "description": "True only after an authenticated operator confirms severity." },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["new", "acknowledged", "resolved"] },
    "snapshot_url": { "type": "string", "pattern": "^/media/snapshots/[A-Za-z0-9._-]+$" },
    "clip_url": { "type": "string", "pattern": "^(/media/clips/[A-Za-z0-9._-]+|/api/incident-video/(physical_altercation|fall_collapse|abnormal_crowd_movement))$" },
    "notes": { "type": "string", "maxLength": 4000 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_seconds", "frames_confirmed", "frames_required"],
      "properties": {
        "window_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
        "frames_confirmed": { "type": "integer", "minimum": 0 },
        "frames_required": { "type": "integer", "minimum": 1 }
      }
    },
    "source": { "type": "string", "enum": ["ai_detection", "simulation"] },
    "priority": { "type": "string", "enum": ["high", "medium", "uncertain", "normal"] },
    "workflow_status": { "type": "string" },
    "workflow_updated_at": { "type": ["string", "null"], "format": "date-time" },
    "notification_status": { "type": "string", "enum": ["pending", "sent", "failed", "not_configured"] },
    "notification_attempts": { "type": "integer", "minimum": 0 },
    "notification_sent_at": { "type": ["string", "null"], "format": "date-time" },
    "acknowledged_at": { "type": ["string", "null"], "format": "date-time" },
    "escalated_at": { "type": ["string", "null"], "format": "date-time" },
    "resolved_at": { "type": ["string", "null"], "format": "date-time" },
    "responder_id": { "type": ["string", "null"] },
    "detection_metadata": { "type": "object" }
  }
}
